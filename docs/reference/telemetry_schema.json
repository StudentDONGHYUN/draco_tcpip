{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "스트리밍 텔레메트리 스키마",
  "type": "object",
  "properties": {
    "frames_encoded": {"type": "integer", "minimum": 0},
    "frames_decoded": {"type": "integer", "minimum": 0},
    "bytes_uplink": {"type": "integer", "minimum": 0},
    "bytes_downlink": {"type": "integer", "minimum": 0},
    "downlink_tx_hz": {
      "type": "number",
      "description": "측정된 다운링크 전송 주파수"
    },
    "downlink_bytes": {
      "type": "integer",
      "description": "제어 평면을 통해 전송된 누적 바이트"
    },
    "pose_age_ms": {
      "type": "number",
      "description": "클라이언트가 소비한 최신 포즈 샘플의 나이"
    },
    "path_len": {
      "type": "integer",
      "description": "가장 최근 경로 메시지의 포즈 수"
    }
  },
  "required": [
    "frames_encoded",
    "frames_decoded",
    "bytes_uplink",
    "bytes_downlink",
    "downlink_tx_hz",
    "downlink_bytes",
    "pose_age_ms",
    "path_len"
  ],
  "additionalProperties": true
}
